+    { 0x00f9, { 0x08, 0x04, 0x11, 0x11, 0x11, 0x13, 0x0d } },  /* ù */
+    { 0x00fa, { 0x02, 0x04, 0x11, 0x11, 0x11, 0x13, 0x0d } },  /* ú */
+    { 0x00fb, { 0x04, 0x0a, 0x11, 0x11, 0x11, 0x13, 0x0d } },  /* û */
+    { 0x00fc, { 0x0a, 0x00, 0x11, 0x11, 0x11, 0x13, 0x0d } },  /* ü */
+    { 0x0152, { 0x1f, 0x15, 0x15, 0x1f, 0x15, 0x15, 0x15 } },  /* Œ */
+    { 0x0153, { 0x00, 0x00, 0x0f, 0x15, 0x15, 0x15, 0x0f } },  /* œ */
+};
+
+static const unsigned int fontExtraCount =
+    (unsigned int)(sizeof(fontExtra) / sizeof(fontExtra[0]));
+
+#endif /* FONT5X7_H */
diff --git a/langblocks/source/gfx.c b/langblocks/source/gfx.c
new file mode 100644
index 0000000..a8dc112
--- /dev/null
+++ b/langblocks/source/gfx.c
@@ -0,0 +1,256 @@
+/* -------------------------------------------------------------------------
+ * gfx.c -- see gfx.h.  All drawing is plain C on top of a 16bpp framebuffer.
+ *
+ * Coordinate system: (0,0) is the top-left of each 256x192 screen.  Every
+ * primitive clips to the screen, so nothing can ever write outside VRAM.
+ * ------------------------------------------------------------------------- */
+#include "gfx.h"
+#include "font5x7.h"
+
+Surface gfxTop;
+Surface gfxBottom;
+
+#ifndef HOST_TEST
+/* Only used when this file is compiled for the PC (see tools/). */
+#else
+static u16 hostTop[SCREEN_W * SCREEN_H];
+static u16 hostBottom[SCREEN_W * SCREEN_H];
+#endif
+
+void gfxInit(void)
+{
+#ifndef HOST_TEST
+    /* Bank A feeds the main engine's background, bank C the sub engine's.  In
+     * 16bpp bitmap mode a full screen needs 96 KiB, which is exactly one bank,
+     * so a single mapping is enough. */
+    vramSetBankA(VRAM_A_MAIN_BG);
+    vramSetBankC(VRAM_C_SUB_BG);
+
+    /* Mode 5 = 256x192 16-bit bitmap on BG2, for both engines. */
+    videoSetMode(MODE_5_2D);
+    videoSetModeSub(MODE_5_2D);
+
+    gfxTop.fb = BG_GFX;
+    gfxBottom.fb = BG_GFX_SUB;
+#else
+    gfxTop.fb = hostTop;
+    gfxBottom.fb = hostBottom;
+#endif
+}
+
+void gfxPresent(void)
+{
+#ifndef HOST_TEST
+    /* Drawing goes straight to VRAM.  Waiting for vblank here paces the whole
+     * app at 60 fps and makes sure the frame we just finished is on screen
+     * before we start overwriting it. */
+    swiWaitForVBlank();
+#endif
+}
+
+/* ------------------------------------------------------------------ pixels */
+
+void surfPixel(Surface *s, int x, int y, u16 color)
+{
+    if ((unsigned)x >= SCREEN_W || (unsigned)y >= SCREEN_H) return;
+    s->fb[y * SCREEN_W + x] = color;
+}
+
+void surfHLine(Surface *s, int x, int y, int w, u16 color)
+{
+    if ((unsigned)y >= SCREEN_H) return;
+    if (x < 0) { w += x; x = 0; }
+    if (x + w > SCREEN_W) w = SCREEN_W - x;
+    if (w <= 0) return;
+    u16 *row = s->fb + y * SCREEN_W + x;
+    while (w-- > 0) *row++ = color;
+}
+
+void surfVLine(Surface *s, int x, int y, int h, u16 color)
+{
+    if ((unsigned)x >= SCREEN_W) return;
+    if (y < 0) { h += y; y = 0; }
+    if (y + h > SCREEN_H) h = SCREEN_H - y;
+    if (h <= 0) return;
+    u16 *p = s->fb + y * SCREEN_W + x;
+    while (h-- > 0) { *p = color; p += SCREEN_W; }
+}
+
+void surfRect(Surface *s, int x, int y, int w, int h, u16 color)
+{
+    if (w <= 0 || h <= 0) return;
+    if (y < 0) { h += y; y = 0; }
+    if (y + h > SCREEN_H) h = SCREEN_H - y;
+    for (int i = 0; i < h; i++) surfHLine(s, x, y + i, w, color);
+}
+
+void surfFrame(Surface *s, int x, int y, int w, int h, u16 color, int thickness)
+{
+    if (thickness <= 0) thickness = 1;
+    surfRect(s, x, y, w, thickness, color);                    /* top    */
+    surfRect(s, x, y + h - thickness, w, thickness, color);    /* bottom */
+    surfRect(s, x, y, thickness, h, color);                    /* left   */
+    surfRect(s, x + w - thickness, y, thickness, h, color);    /* right  */
+}
+
+void surfClear(Surface *s, u16 color)
+{
+    surfRect(s, 0, 0, SCREEN_W, SCREEN_H, color);
+}
+
+void surfCard(Surface *s, int x, int y, int w, int h, u16 fill, u16 border,
+              int pressed)
+{
+    surfRect(s, x, y, w, h, pressed ? border : fill);
+    surfFrame(s, x, y, w, h, border, 1);
+    if (!pressed) {
+        /* A lighter 1px line along the top edge fakes a subtle bevel. */
+        surfHLine(s, x + 1, y + 1, w - 2, COL_PANEL_HI);
+    }
+}
+
+/* -------------------------------------------------------------------- text */
+
+int utf8Decode(const char *text, u16 *codepoint)
+{
+    const unsigned char *p = (const unsigned char *)text;
+    if (p[0] < 0x80) {
+        *codepoint = p[0];
+        return 1;
+    }
+    if ((p[0] & 0xE0) == 0xC0) {
+        *codepoint = (u16)(((p[0] & 0x1F) << 6) | (p[1] & 0x3F));
+        return 2;
+    }
+    if ((p[0] & 0xF0) == 0xE0) {
+        *codepoint = (u16)(((p[0] & 0x0F) << 12) |
+                           ((p[1] & 0x3F) << 6) | (p[2] & 0x3F));
+        return 3;
+    }
+    *codepoint = '?';
+    return 1;
+}
+
+static const u8 *glyphFor(u16 cp)
+{
+    if (cp >= 0x20 && cp <= 0x7E) return fontAscii[cp - 0x20];
+    for (unsigned int i = 0; i < fontExtraCount; i++) {
+        if (fontExtra[i].cp == cp) return fontExtra[i].rows;
+    }
+    /* Unknown character (an emoji, say) shows as '?' rather than nothing. */
+    return fontAscii['?' - 0x20];
+}
+
+int textLineHeight(int scale)
+{
+    return FONT_LINE * scale;
+}
+
+int textWidthN(const char *text, int bytes, int scale)
+{
+    if (bytes <= 0) return 0;
+    int count = 0;
+    const char *p = text;
+    const char *end = text + bytes;
+    while (p < end && *p) {
+        u16 cp;
+        p += utf8Decode(p, &cp);
+        count++;
+    }
+    return count * FONT_ADVANCE * scale - scale;   /* no gap after last glyph */
+}
+
+int textWidth(const char *text, int scale)
+{
+    int n = 0;
+    while (text[n]) n++;
+    return textWidthN(text, n, scale);
+}
+
+void surfTextN(Surface *s, int x, int y, const char *text, int bytes,
+               u16 color, int scale)
+{
+    const char *p = text;
+    const char *end = text + bytes;
+
+    while (p < end && *p) {
+        u16 cp;
+        p += utf8Decode(p, &cp);
+        const u8 *rows = glyphFor(cp);
+
+        for (int ry = 0; ry < FONT_H; ry++) {
+            u8 bits = rows[ry];
+            if (!bits) continue;
+            for (int rx = 0; rx < FONT_W; rx++) {
+                if (!(bits & (1u << (FONT_W - 1 - rx)))) continue;
+                int px = x + rx * scale;
+                int py = y + ry * scale;
+                for (int sy = 0; sy < scale; sy++) {
+                    surfHLine(s, px, py + sy, scale, color);
+                }
+            }
+        }
+        x += FONT_ADVANCE * scale;
+    }
+}
+
+void surfText(Surface *s, int x, int y, const char *text, u16 color, int scale)
+{
+    int n = 0;
+    while (text[n]) n++;
+    surfTextN(s, x, y, text, n, color, scale);
+}
+
+void surfTextCentered(Surface *s, int cx, int y, const char *text, u16 color,
+                      int scale)
+{
+    surfText(s, cx - textWidth(text, scale) / 2, y, text, color, scale);
+}
+
+/* Shared word-wrap walker.  When `s` is NULL it only measures. */
+static int wrapRun(Surface *s, int x, int y, int maxWidth, const char *text,
+                   u16 color, int scale, int draw)
+{
+    const int lineH = textLineHeight(scale);
+    const int x0 = x;
+    int cy = y;
+    const char *p = text;
+
+    while (*p) {
+        if (*p == '\n') {              /* hard line break in the source text */
+            cy += lineH;
+            x = x0;
+            p++;
+            continue;
+        }
+        if (*p == ' ') {               /* spaces only separate words        */
+            p++;
+            continue;
+        }
+
+        const char *word = p;
+        while (*p && *p != ' ' && *p != '\n') p++;
+        int bytes = (int)(p - word);
+        int wordW = textWidthN(word, bytes, scale);
+
+        if (x > x0 && x + wordW > x0 + maxWidth) {
+            cy += lineH;
+            x = x0;
+        }
+        if (draw) surfTextN(s, x, cy, word, bytes, color, scale);
+        x += wordW + FONT_ADVANCE * scale;
+    }
+    return cy + lineH;
+}
+
+int surfTextWrapped(Surface *s, int x, int y, int maxWidth, const char *text,
+                    u16 color, int scale)
+{
+    return wrapRun(s, x, y, maxWidth, text, color, scale, 1);
+}
+
+int wrappedHeight(int maxWidth, const char *text, int scale)
+{
+    /* Measure relative to y=0 so the return value is a height. */
+    return wrapRun(NULL, 0, 0, maxWidth, text, 0, scale, 0);
+}
diff --git a/langblocks/source/gfx.h b/langblocks/source/gfx.h
new file mode 100644
index 0000000..d8d6ca7
--- /dev/null
+++ b/langblocks/source/gfx.h
@@ -0,0 +1,92 @@
+/* -------------------------------------------------------------------------
+ * gfx.h -- tiny software renderer for the two 256x192 screens.
+ *
+ * Why a software renderer?  The DSi has no font or UI toolkit built in, and
+ * shipping bitmap assets would add a grit/asset pipeline to the build.  Both
+ * screens are instead put into 16bpp bitmap mode (MODE_5_2D) and every pixel
+ * is written by hand.  That keeps the whole app in plain C with no external
+ * data files, while still giving us colour, panels and a readable font.
+ *
+ * Everything is drawn into a `Surface` (a raw framebuffer pointer).  Writes
+ * outside 0..255 x 0..191 are clipped, so a layout bug can never scribble
+ * over VRAM that belongs to something else.
+ * ------------------------------------------------------------------------- */
+#ifndef GFX_H
+#define GFX_H
+
+#include "platform.h"
+
+#define SCREEN_W 256
+#define SCREEN_H 192
+
+/* 15-bit BGR555 colour, the native format of the DS LCDs.  libnds already
+ * defines RGB15, so only define it for the host build. */
+#ifndef RGB15
+#define RGB15(r, g, b) ((u16)(((b) << 10) | ((g) << 5) | (r)))
+#endif
+
+/* Palette used by the whole app ------------------------------------------ */
+#define COL_BG        RGB15(2, 3, 7)      /* deep navy background        */
+#define COL_PANEL     RGB15(4, 6, 12)     /* card background             */
+#define COL_PANEL_HI  RGB15(7, 10, 18)    /* raised / hovered card       */
+#define COL_BORDER    RGB15(11, 16, 26)   /* card outline                */
+#define COL_TEXT      RGB15(29, 30, 31)   /* near-white body text        */
+#define COL_TEXT_DIM  RGB15(13, 16, 21)   /* secondary text              */
+#define COL_GOLD      RGB15(31, 24, 6)    /* XP / streak accent          */
+#define COL_GREEN     RGB15(6, 28, 14)    /* correct                     */
+#define COL_DARKGREEN RGB15(3, 14, 8)     /* correct panel fill          */
+#define COL_RED       RGB15(31, 8, 10)    /* wrong                       */
+#define COL_DARKRED   RGB15(15, 4, 6)     /* wrong panel fill            */
+#define COL_BLUE      RGB15(8, 20, 31)    /* info accent                 */
+#define COL_CYAN      RGB15(6, 26, 28)    /* timer accent                */
+
+/* One framebuffer.  `fb` points either at VRAM (main/sub engine) or, when
+ * running on the host, at a scratch array. */
+typedef struct {
+    u16 *fb;
+} Surface;
+
+extern Surface gfxTop;      /* main engine   (the upper screen) */
+extern Surface gfxBottom;   /* sub engine    (the touch screen) */
+
+/* Set both screens to 16bpp bitmap mode and point the surfaces at VRAM. */
+void gfxInit(void);
+
+/* Wait for the vertical blank so the frame we just drew is shown whole.
+ * Drawing happens straight into VRAM, so this is also the frame pacer. */
+void gfxPresent(void);
+
+/* ---------------------------------------------------------------- drawing */
+void surfClear(Surface *s, u16 color);
+void surfRect(Surface *s, int x, int y, int w, int h, u16 color);
+void surfFrame(Surface *s, int x, int y, int w, int h, u16 color, int thickness);
+void surfHLine(Surface *s, int x, int y, int w, u16 color);
+void surfVLine(Surface *s, int x, int y, int h, u16 color);
+void surfPixel(Surface *s, int x, int y, u16 color);
+
+/* A filled card with a border and a 1px top highlight -- the app's standard
+ * "button" look.  `pressed` swaps the colours so touch feedback is obvious. */
+void surfCard(Surface *s, int x, int y, int w, int h, u16 fill, u16 border,
+              int pressed);
+
+/* ------------------------------------------------------------------- text */
+/* Monospaced 5x7 glyphs, 6px advance, 9px line height (see fonts/font5x7.h). */
+void surfText(Surface *s, int x, int y, const char *text, u16 color, int scale);
+void surfTextN(Surface *s, int x, int y, const char *text, int bytes,
+               u16 color, int scale);
+int  textWidth(const char *text, int scale);
+int  textWidthN(const char *text, int bytes, int scale);
+int  textLineHeight(int scale);
+void surfTextCentered(Surface *s, int cx, int y, const char *text, u16 color,
+                      int scale);
+
+/* Word-wrapped text.  Returns the y coordinate just below the last line, so
+ * callers can stack blocks of copy. */
+int  surfTextWrapped(Surface *s, int x, int y, int maxWidth, const char *text,
+                     u16 color, int scale);
+int  wrappedHeight(int maxWidth, const char *text, int scale);
+
+/* Draw a single UTF-8 code point at the pen position (used by the helpers). */
+int  utf8Decode(const char *text, u16 *codepoint);
+
+#endif /* GFX_H */
diff --git a/langblocks/source/main.c b/langblocks/source/main.c
new file mode 100644
index 0000000..5dde214
--- /dev/null
+++ b/langblocks/source/main.c
@@ -0,0 +1,1099 @@
+/* -------------------------------------------------------------------------
+ * main.c -- Linguablocks: Spanish/French drills with a game-time bank that
+ *           pays for the Tetris and Chess mini-games.
+ *
+ * Screen split
+ * ------------
+ *   Top screen    : the 10 second countdown, streak, XP, banked game time,
+ *                   the question itself and the grammar explanation.
+ *   Bottom screen : the four big touch targets, the menus, the drill setup
+ *                   toggles, the Tetris board or the chess board.
+ *
+ * The app is a simple frame loop at 60 fps:
+ *   1. read keys + touch,
+ *   2. update the current state,
+ *   3. draw,
+ *   4. wait for vblank.
+ * Everything is table driven, so there is no dynamic memory anywhere.
+ * ------------------------------------------------------------------------- */
+#include <stdio.h>
+#include <string.h>
+
+#include "chess.h"
+#include "conjugate.h"
+#include "data.h"
+#include "gfx.h"
+#include "quiz.h"
+#include "save.h"
+#include "sound.h"
+#include "tetris.h"
+
+/* ------------------------------------------------------------------ timing */
+
+#define FPS               60
+#define QUIZ_SECONDS      10
+#define QUIZ_FRAMES       (FPS * QUIZ_SECONDS)
+#define FEEDBACK_FRAMES   (FPS * 5)     /* auto-advance after 5 s          */
+#define MIN_GAME_MS       5000u         /* need at least 5 s to start      */
+#define GOAL_BONUS_MS     30000u        /* +30 s for hitting the daily goal*/
+#define CHESS_WIN_BONUS   500           /* points added for checkmate      */
+#define CHESS_DRAW_BONUS  150
+
+/* ------------------------------------------------------------------- state */
+
+typedef enum {
+    ST_LANGUAGE = 0,
+    ST_MENU,
+    ST_SETUP,
+    ST_QUIZ,
+    ST_TETRIS,
+    ST_CHESS,
+    ST_TETRIS_OVER,
+    ST_CHESS_OVER
+} AppState;
+
+static AppState state = ST_MENU;
+static Lang lang = LANG_ES;
+
+static Question question;
+static unsigned int quizKinds = QK_MASK_ALL;
+static int quizPhase;                 /* 0 = asking, 1 = feedback          */
+static int selectedOption;            /* -1 until the player answers       */
+static int timeLeftFrames;
+static int feedbackFrames;
+static int answerWasCorrect;
+
+static int streak;                    /* consecutive correct answers       */
+static int cursorOption;              /* D-pad selection while answering   */
+static int langCursor;                /* 0 = Spanish, 1 = French           */
+static int goalBannerFrames;
+static int toastFrames;
+static char toastText[64];
+
+static Tetris tetris;
+static ChessGame chess;
+static u32 frameMsCarry;              /* keeps the ms countdown accurate   */
+
+static u32 frameCounter;
+static int screenDirty = 1;           /* force a full redraw                */
+
+/* input snapshot ---------------------------------------------------------- */
+static u32 keysPressed, keysHeldNow;
+static int touchPressed, touchDownNow, touchX, touchY;
+static int prevTouch;
+static int holdButton;
+static int holdTimer;
+
+/* touch rectangles -------------------------------------------------------- */
+static const short optionRect[4][4] = {
+    {   4, 26, 120, 72 },
+    { 132, 26, 120, 72 },
+    {   4, 102, 120, 72 },
+    { 132, 102, 120, 72 },
+};
+
+/* five main-menu rows */
+static const short menuRect[5][4] = {
+    {   8, 32, 240, 26 },
+    {   8, 62, 240, 26 },
+    {   8, 92, 240, 26 },
+    {   8, 122, 240, 26 },
+    {   8, 152, 240, 26 },
+};
+
+/* drill setup: four toggles, then start and back */
+static const short toggleRect[4][4] = {
+    {   8, 26, 116, 44 },
+    { 132, 26, 116, 44 },
+    {   8, 76, 116, 44 },
+    { 132, 76, 116, 44 },
+};
+static const short setupStartRect[4] = { 8, 128, 240, 26 };
+static const short setupBackRect[4]  = { 8, 160, 240, 24 };
+
+/* --------------------------------------------------------------- utilities */
+
+static void formatClock(u32 ms, char *buf, int size)
+{
+    u32 total = ms / 1000;
+    if (total > 99 * 60) total = 99 * 60;
+    snprintf(buf, (size_t)size, "%02u:%02u", (unsigned)(total / 60),
+             (unsigned)(total % 60));
+}
+
+static int pointInRect(int x, int y, const short r[4])
+{
+    return x >= r[0] && x < r[0] + r[2] && y >= r[1] && y < r[1] + r[3];
+}
+
+static void showToast(const char *text)
+{
+    snprintf(toastText, sizeof(toastText), "%s", text);
+    toastFrames = FPS * 2;
+}
+
+/* Clamp the banked time and keep XP in a sane range. */
+static void clampProgress(void)
+{
+    if (save.gameMs > MAX_BANK_MS) save.gameMs = MAX_BANK_MS;
+    if (save.xp > 999999u) save.xp = 999999u;
+}
+
+/* ------------------------------------------------------------------- input */
+
+static void pollInput(void)
+{
+    scanKeys();
+    keysPressed = keysDown();
+    keysHeldNow = keysHeld();
+
+    touchPosition t;
+    int down = touchRead(&t) ? 1 : 0;
+    if (down && (t.px != 0 || t.py != 0)) {
+        touchX = t.px;
+        touchY = t.py;
+        touchDownNow = 1;
+        touchPressed = !prevTouch;
+        prevTouch = 1;
+    } else {
+        touchDownNow = 0;
+        touchPressed = 0;
+        prevTouch = 0;
+    }
+}
+
+/* ------------------------------------------------------------- quiz screens */
+
+static void drawHud(void)
+{
+    Surface *s = &gfxTop;
+    char buf[32];
+
+    /* clear the HUD strip only -- the question below stays untouched */
+    surfRect(s, 0, 0, SCREEN_W, 28, COL_PANEL);
+    surfHLine(s, 0, 27, SCREEN_W, COL_BORDER);
+
+    surfText(s, 6, 3, "TIME", COL_TEXT_DIM, 1);
+    int barX = 40, barW = 128, barH = 7, barY = 4;
+    surfRect(s, barX, barY, barW, barH, COL_BORDER);
+
+    int left = timeLeftFrames;
+    if (left < 0) left = 0;
+    if (left > QUIZ_FRAMES) left = QUIZ_FRAMES;
+    int filled = barW * left / QUIZ_FRAMES;
+    u16 barColor = COL_CYAN;
+    if (left <= QUIZ_FRAMES / 3) barColor = COL_RED;
+    else if (left <= QUIZ_FRAMES / 2) barColor = COL_GOLD;
+    if (filled > 0) surfRect(s, barX, barY, filled, barH, barColor);
+
+    /* seconds with one decimal, e.g. "9.4s" */
+    int tenths = (left * 10 + QUIZ_FRAMES - 1) / QUIZ_FRAMES;
+    snprintf(buf, sizeof(buf), "%d.%ds", tenths / 10, tenths % 10);
+    surfText(s, 176, 1, buf, left <= QUIZ_FRAMES / 3 ? COL_RED : COL_TEXT, 2);
+
+    /* second row: streak, XP, banked game time (shared by both mini-games) */
+    snprintf(buf, sizeof(buf), "STREAK x%d", streak);
+    surfText(s, 6, 16, buf, streak > 0 ? COL_GOLD : COL_TEXT_DIM, 1);
+
+    snprintf(buf, sizeof(buf), "XP %lu", (unsigned long)save.xp);
+    surfText(s, 86, 16, buf, COL_TEXT, 1);
+
+    char clock[12];
+    formatClock(save.gameMs, clock, sizeof(clock));
+    snprintf(buf, sizeof(buf), "GAME %s", clock);
+    surfText(s, 152, 16, buf, COL_CYAN, 1);
+}
+
+/* Draw the four answer cards on the bottom screen. */
+static void drawOptions(void)
+{
+    Surface *s = &gfxBottom;
+
+    for (int i = 0; i < 4; i++) {
+        const short *r = optionRect[i];
+        u16 fill = COL_PANEL;
+        u16 border = COL_BORDER;
+        u16 textColor = COL_TEXT;
+
+        if (quizPhase == 1) {
+            if (i == question.correct) {
+                fill = COL_DARKGREEN;
+                border = COL_GREEN;
+                textColor = COL_GREEN;
+            } else if (i == selectedOption) {
+                fill = COL_DARKRED;
+                border = COL_RED;
+                textColor = COL_RED;
+            }
+        } else if (i == cursorOption) {
+            border = COL_GOLD;
+        }
+
+        surfCard(s, r[0], r[1], r[2], r[3], fill, border, 0);
+
+        /* letter badge */
+        static const char letters[5] = "ABCD";
+        char label[2] = { letters[i], '\0' };
+        surfRect(s, r[0] + 6, r[1] + 6, 14, 14, border);
+        surfTextCentered(s, r[0] + 13, r[1] + 10, label, textColor, 1);
+
+        /* option text, wrapped and centred in the card */
+        int textW = r[2] - 14;
+        int scale = (int)strlen(question.options[i]) <= 9 ? 2 : 1;
+        int height = wrappedHeight(textW, question.options[i], scale);
+        int ty = r[1] + 24 + (r[3] - 26 - height) / 2;
+        surfTextWrapped(s, r[0] + 7, ty, textW, question.options[i], textColor,
+                        scale);
+    }
+
+    if (quizPhase == 1) {
+        surfTextCentered(&gfxBottom, 128, 178, "TAP TO CONTINUE", COL_TEXT_DIM,
+                         1);
+    } else {
+        surfTextCentered(&gfxBottom, 128, 178, "TAP AN ANSWER  (or D-PAD + A)",
+                         COL_TEXT_DIM, 1);
+    }
+}
