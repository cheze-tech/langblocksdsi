+/* ------------------------------------------------------------- tetris state */
+
+static void startTetris(void)
+{
+    if (save.gameMs < MIN_GAME_MS) {
+        showToast("EARN MORE GAME TIME");
+        sndWrong();
+        screenDirty = 1;
+        return;
+    }
+    tetrisSeed(0x9E3779B9u ^ (frameCounter * 40503u) ^ save.xp);
+    tetrisNew(&tetris);
+    frameMsCarry = 0;
+    state = ST_TETRIS;
+    screenDirty = 1;
+    saveNow();
+}
+
+static void finishTetris(TetrisOverReason reason)
+{
+    tetris.state = TS_OVER;
+    tetris.overReason = reason;
+
+    /* A little XP for playing, so the reward loop pays out either way. */
+    save.xp += tetris.score / 10u;
+    clampProgress();
+
+    if (tetris.score > save.bestTetrisScore) save.bestTetrisScore = tetris.score;
+    if ((u32)tetris.lines > save.bestLines) save.bestLines = (u32)tetris.lines;
+    save.tetrisGames++;
+
+    state = ST_TETRIS_OVER;
+    screenDirty = 1;
+    saveNow();
+}
+
+/* One frame of Tetris: clock, gravity and input. */
+static void updateTetris(void)
+{
+    /* Count down the banked time, 1/60 s at a time without drifting. */
+    if (tetris.state == TS_PLAYING) {
+        frameMsCarry += 1000;
+        u32 ms = frameMsCarry / FPS;
+        frameMsCarry -= ms * FPS;
+        if (save.gameMs > ms) save.gameMs -= ms;
+        else {
+            save.gameMs = 0;
+            finishTetris(TO_TIME_UP);
+            return;
+        }
+        tetrisStep(&tetris);
+    }
+
+    /* --- D-pad, with our own auto-repeat so we control the feel ---------- */
+    int move = 0;
+    if (keysPressed & KEY_LEFT) move = -1;
+    if (keysPressed & KEY_RIGHT) move = 1;
+    if (keysHeldNow & KEY_LEFT) {
+        if (holdButton != KEY_LEFT) { holdButton = KEY_LEFT; holdTimer = 0; }
+        else if (++holdTimer >= 6) { holdTimer = 2; move = -1; }
+    } else if (keysHeldNow & KEY_RIGHT) {
+        if (holdButton != KEY_RIGHT) { holdButton = KEY_RIGHT; holdTimer = 0; }
+        else if (++holdTimer >= 6) { holdTimer = 2; move = 1; }
+    } else if (keysHeldNow & KEY_DOWN) {
+        if (holdButton != KEY_DOWN) { holdButton = KEY_DOWN; holdTimer = 0; }
+        else if (++holdTimer >= 4) { holdTimer = 1; tetrisSoftDrop(&tetris); }
+    } else {
+        holdButton = -1;
+    }
+    if (move) tetrisMove(&tetris, move);
+
+    if (keysPressed & KEY_A) tetrisRotate(&tetris);
+    if (keysPressed & KEY_B) tetrisHardDrop(&tetris);
+    if (keysPressed & KEY_START) {
+        tetrisTogglePause(&tetris);
+        sndClick();
+    }
+    if (keysPressed & KEY_SELECT) {
+        saveNow();
+        openMenu();
+        return;
+    }
+
+    /* --- touch controls ------------------------------------------------- */
+    if (touchPressed || touchDownNow) {
+        int hit = tetrisHitTest(touchX, touchY);
+        if (hit >= 0) {
+            if (touchPressed) {
+                holdButton = -100 - hit;      /* separate namespace from keys */
+                holdTimer = 0;
+                switch (hit) {
+                case TB_ROTATE: tetrisRotate(&tetris); break;
+                case TB_DROP:   tetrisHardDrop(&tetris); break;
+                case TB_PAUSE:  tetrisTogglePause(&tetris); sndClick(); break;
+                case TB_LEFT:   tetrisMove(&tetris, -1); break;
+                case TB_RIGHT:  tetrisMove(&tetris, 1); break;
+                case TB_DOWN:   tetrisSoftDrop(&tetris); break;
+                default: break;
+                }
+            } else if (holdButton == -100 - hit) {
+                int rate = (hit == TB_DOWN) ? 4 : 6;
+                if (++holdTimer >= rate) {
+                    holdTimer = 0;
+                    if (hit == TB_LEFT) tetrisMove(&tetris, -1);
+                    else if (hit == TB_RIGHT) tetrisMove(&tetris, 1);
+                    else if (hit == TB_DOWN) tetrisSoftDrop(&tetris);
+                }
+            }
+        }
+    }
+
+    if (tetris.state == TS_OVER) {
+        finishTetris(tetris.overReason == TO_TOP_OUT ? TO_TOP_OUT : TO_TIME_UP);
+    }
+}
+
+/* -------------------------------------------------------------- chess state */
+
+static void startChess(void)
+{
+    if (save.gameMs < MIN_GAME_MS) {
+        showToast("EARN MORE GAME TIME");
+        sndWrong();
+        screenDirty = 1;
+        return;
+    }
+    chessNewGame(&chess);
+    frameMsCarry = 0;
+    state = ST_CHESS;
+    screenDirty = 1;
+    saveNow();
+}
+
+static void endChess(int result)
+{
+    /* Points for a win or a draw, then the score becomes XP. */
+    if (result == CHESS_WHITE_WIN) chess.score += CHESS_WIN_BONUS;
+    else if (result == CHESS_DRAW || result == CHESS_STALEMATE)
+        chess.score += CHESS_DRAW_BONUS;
+
+    chess.result = result;
+
+    save.xp += (u32)(chess.score / 10);
+    clampProgress();
+
+    if ((u32)chess.score > save.bestChessScore)
+        save.bestChessScore = (u32)chess.score;
+    save.chessGames++;
+
+    state = ST_CHESS_OVER;
+    screenDirty = 1;
+    saveNow();
+}
+
+static void updateChess(void)
+{
+    /* The game clock runs while the player is in the chess screen, whichever
+     * side is thinking. */
+    if (chess.result == CHESS_ONGOING) {
+        frameMsCarry += 1000;
+        u32 ms = frameMsCarry / FPS;
+        frameMsCarry -= ms * FPS;
+        if (save.gameMs > ms) {
+            save.gameMs -= ms;
+        } else {
+            save.gameMs = 0;
+            endChess(CHESS_TIMEOUT);
+            return;
+        }
+    }
+
+    if (keysPressed & KEY_SELECT) {
+        saveNow();
+        openMenu();
+        return;
+    }
+
+    /* Two-frame "thinking" state: one frame to draw the message, then the
+     * search runs.  It keeps the AI from freezing the screen without warning. */
+    if (chess.thinking > 0) {
+        if (--chess.thinking == 0) {
+            chessPlayAi(&chess);
+            screenDirty = 1;
+            if (chess.result != CHESS_ONGOING) {
+                endChess(chess.result);
+                return;
+            }
+        }
+    }
+
+    if (touchPressed) {
+        if (chessTouchResign(touchX, touchY)) {
+            endChess(CHESS_RESIGNED);
+            return;
+        }
+        int sq = chessTouchSquare(touchX, touchY);
+        if (sq >= 0 && chessTap(&chess, sq)) {
+            sndClick();
+            screenDirty = 1;
+            if (chess.result != CHESS_ONGOING) {
+                endChess(chess.result);
+                return;
+            }
+            if (chess.board.side == CH_BLACK) chess.thinking = 2;
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- painting */
+
+static void render(void)
+{
+    switch (state) {
+    case ST_LANGUAGE:
+        if (screenDirty) {
+            drawLanguageMenu();
+            screenDirty = 0;
+        }
+        break;
+
+    case ST_MENU:
+        if (screenDirty) {
+            drawMenu();
+            screenDirty = 0;
+        }
+        break;
+
+    case ST_SETUP:
+        if (screenDirty) {
+            drawSetup();
+            screenDirty = 0;
+        }
+        break;
+
+    case ST_QUIZ:
+        if (screenDirty) {
+            drawQuestion();
+            drawOptions();
+            screenDirty = 0;
+        } else {
+            drawHud();                 /* only the countdown keeps moving */
+        }
+        break;
+
+    case ST_TETRIS:
+        tetrisDraw(&tetris, &gfxBottom, &gfxTop, save.gameMs);
+        break;
+
+    case ST_CHESS:
+        chessDrawGame(&chess, &gfxBottom, &gfxTop, save.gameMs,
+                      chessInCheck(&chess.board, chess.board.side));
+        break;
+
+    case ST_TETRIS_OVER:
+        if (screenDirty) {
+            tetrisDrawGameOver(&tetris, &gfxBottom, &gfxTop);
+            screenDirty = 0;
+        }
+        break;
+
+    case ST_CHESS_OVER:
+        if (screenDirty) {
+            chessDrawResult(&chess, &gfxBottom, &gfxTop);
+            screenDirty = 0;
+        }
+        break;
+    }
+
+    if (toastFrames > 0) {
+        surfRect(&gfxBottom, 8, 168, 240, 16, COL_DARKRED);
+        surfTextCentered(&gfxBottom, 128, 171, toastText, COL_TEXT, 1);
+    }
+}
+
+/* ------------------------------------------------------------------- menus */
+
+static void chooseLanguage(int which)
+{
+    lang = (Lang)which;
+    save.lang = (u32)lang;
+    saveNow();
+    sndClick();
+    openMenu();
+}
+
+static void handleLanguageMenu(void)
+{
+    int choose = -1;
+
+    if (touchPressed) {
+        if (pointInRect(touchX, touchY, (const short[4]){ 12, 34, 232, 56 })) {
+            choose = LANG_ES;
+        } else if (pointInRect(touchX, touchY,
+                              (const short[4]){ 12, 104, 232, 56 })) {
+            choose = LANG_FR;
+        }
+    }
+
+    if (keysPressed & (KEY_UP | KEY_LEFT))  { langCursor = 0; screenDirty = 1; }
+    if (keysPressed & (KEY_DOWN | KEY_RIGHT)) { langCursor = 1; screenDirty = 1; }
+    if (keysPressed & KEY_A) choose = langCursor;
+    if ((keysPressed & KEY_B) && save.totalAsked > 0) {
+        openMenu();        /* allow backing out unless this is a first run */
+        return;
+    }
+
+    if (choose >= 0) chooseLanguage(choose);
+}
+
+static void handleMenu(void)
+{
+    int choice = -1;
+
+    if (touchPressed) {
+        for (int i = 0; i < 5; i++) {
+            if (pointInRect(touchX, touchY, menuRect[i])) {
+                choice = i;
+                break;
+            }
+        }
+    }
+    if (keysPressed & KEY_A) choice = 0;      /* quick start */
+
+    if (keysPressed & KEY_B) {
+        openMenu();                    /* flushes the save and repaints */
+        return;
+    }
+
+    switch (choice) {
+    case 0: startQuiz(save.drillMask); break;
+    case 1: state = ST_SETUP; screenDirty = 1; break;
+    case 2: startTetris(); break;
+    case 3: startChess(); break;
+    case 4: state = ST_LANGUAGE; screenDirty = 1; break;
+    default: break;
+    }
+}
+
+/* -------------------------------------------------------------------- main */
+
+int main(void)
+{
+    gfxInit();
+    sndInit();
+
+    saveInit();          /* mounts the SD card and loads the profile */
+    saveNewSession();    /* streak bookkeeping for this play session    */
+
+    lang = (Lang)(save.lang < LANG_COUNT ? save.lang : 0);
+    quizKinds = save.drillMask ? save.drillMask : QK_MASK_ALL;
+
+    /* No profile yet?  Start by choosing a language.  (XP is only ever awarded
+     * by playing, so a virgin profile is a reliable "first run" marker.) */
+    if (save.totalAsked == 0 && save.xp == 0) {
+        state = ST_LANGUAGE;
+    } else {
+        state = ST_MENU;
+    }
+    screenDirty = 1;
+
+    while (1) {
+        pollInput();
+
+        if (toastFrames > 0) toastFrames--;
+        if (goalBannerFrames > 0) goalBannerFrames--;
+
+        switch (state) {
+        case ST_LANGUAGE:
+            handleLanguageMenu();
+            break;
+
+        case ST_MENU:
+            handleMenu();
+            break;
+
+        case ST_SETUP:
+            handleSetup();
+            break;
+
+        case ST_QUIZ:
+            if (keysPressed & KEY_B) {
+                saveNow();
+                openMenu();
+            } else {
+                updateQuiz();
+            }
+            break;
+
+        case ST_TETRIS:
+            updateTetris();
+            break;
+
+        case ST_CHESS:
+            updateChess();
+            break;
+
+        case ST_TETRIS_OVER:
+        case ST_CHESS_OVER:
+            if (touchPressed || (keysPressed & (KEY_A | KEY_B | KEY_START))) {
+                sndClick();
+                openMenu();
+            }
+            break;
+        }
+
+        render();
+        gfxPresent();
+        frameCounter++;
+
+        /* Make sure progress survives the console being switched off while the
+         * player is idle in the menu. */
+        if ((frameCounter % (FPS * 20)) == 0 && state == ST_MENU) saveNow();
+    }
+
+    return 0;
+}
diff --git a/langblocks/source/platform.h b/langblocks/source/platform.h
new file mode 100644
index 0000000..4f528e8
--- /dev/null
+++ b/langblocks/source/platform.h
@@ -0,0 +1,26 @@
+/* -------------------------------------------------------------------------
+ * platform.h -- the one place that knows whether we are building for the DSi
+ *               or for the host PC (used by tools/test_tetris_host.c).
+ *
+ * On the DSi we simply pull in <nds.h>, which gives us u8/u16/u32 and the
+ * whole libnds API.  When HOST_TEST is defined we provide the same small set
+ * of integer typedefs with <stdint.h> so that pure-logic modules (tetris.c)
+ * can be compiled and fuzz-tested with a normal desktop compiler.
+ * ------------------------------------------------------------------------- */
+#ifndef PLATFORM_H
+#define PLATFORM_H
+
+#ifdef HOST_TEST
+#include <stdint.h>
+#include <stddef.h>
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef int8_t   s8;
+typedef int16_t  s16;
+typedef int32_t  s32;
+#else
+#include <nds.h>
+#endif
+
+#endif /* PLATFORM_H */
diff --git a/langblocks/source/quiz.c b/langblocks/source/quiz.c
new file mode 100644
index 0000000..cb10224
--- /dev/null
+++ b/langblocks/source/quiz.c
@@ -0,0 +1,332 @@
+/* -------------------------------------------------------------------------
+ * quiz.c -- question generation.
+ *
+ * Every question is built in four steps:
+ *   1. pick the subject (a word, a sentence, or a verb+tense+person),
+ *   2. compute the correct answer,
+ *   3. gather three plausible wrong answers,
+ *   4. shuffle, and keep a pointer to where the right answer ended up.
+ * The explanation is generated at the same time, because that is the moment
+ * when we still know exactly which rule was tested.
+ * ------------------------------------------------------------------------- */
+#include <stdio.h>
+#include <string.h>
+
+#include "quiz.h"
+#include "conjugate.h"
+
+static u32 rngState = 0x9E3779B9u;
+
+void quizSeed(u32 seed)
+{
+    rngState = seed ? seed : 0x9E3779B9u;
+}
+
+static u32 rnd(void)
+{
+    /* xorshift32: cheap, no library, good enough for shuffling options. */
+    rngState ^= rngState << 13;
+    rngState ^= rngState >> 17;
+    rngState ^= rngState << 5;
+    return rngState;
+}
+
+static int rndInt(int n)
+{
+    if (n <= 0) return 0;
+    return (int)(rnd() % (u32)n);
+}
+
+static void setText(char *dst, int size, const char *src)
+{
+    /* snprintf truncates safely and always NUL-terminates. */
+    snprintf(dst, (size_t)size, "%s", src);
+}
+
+static void setOption(Question *q, int i, const char *text)
+{
+    setText(q->options[i], sizeof(q->options[i]), text);
+}
+
+/* Shuffle the four options and remember where the right one landed. */
+static void finishOptions(Question *q)
+{
+    for (int i = 3; i > 0; i--) {
+        int j = rndInt(i + 1);
+        char tmp[56];
+        memcpy(tmp, q->options[i], sizeof(tmp));
+        memcpy(q->options[i], q->options[j], sizeof(tmp));
+        memcpy(q->options[j], tmp, sizeof(tmp));
+    }
+    q->correct = -1;
+    for (int i = 0; i < 4; i++) {
+        if (strcmp(q->options[i], q->answer) == 0) {
+            q->correct = i;
+            break;
+        }
+    }
+    if (q->correct < 0) {
+        /* Should never happen, but never leave the game without a valid index. */
+        setOption(q, 0, q->answer);
+        q->correct = 0;
+    }
+}
+
+static int alreadyUsed(const Question *q, int count, const char *text)
+{
+    for (int i = 0; i < count; i++) {
+        if (strcmp(q->options[i], text) == 0) return 1;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------- flashcards */
+
+static void makeFlashcard(Lang lang, Question *q)
+{
+    const LangPack *p = &langPacks[lang];
+    int idx = rndInt(p->vocabCount);
+
+    q->kind = QK_FLASH;
+    snprintf(q->label, sizeof(q->label), "FLASHCARD   %s > %s", p->code,
+             p->code);
+    setText(q->prompt, sizeof(q->prompt), p->vocab[idx].en);
+    setText(q->hint, sizeof(q->hint),
+            lang == LANG_ES ? "How do you say this in Spanish?"
+                            : "How do you say this in French?");
+    setText(q->answer, sizeof(q->answer), p->vocab[idx].tgt);
+    q->big = 1;
+
+    setOption(q, 0, q->answer);
+    int made = 1;
+    int guard = 0;
+    while (made < 4 && guard++ < 200) {
+        int other = rndInt(p->vocabCount);
+        const char *cand = p->vocab[other].tgt;
+        if (alreadyUsed(q, made, cand)) continue;
+        setOption(q, made, cand);
+        made++;
+    }
+    /* Fill any leftovers (tiny vocabulary) so we always have 4 options. */
+    while (made < 4) {
+        setOption(q, made, "————");
+        made++;
+    }
+
+    finishOptions(q);
+    snprintf(q->explanation, sizeof(q->explanation),
+             "\"%s\" is \"%s\" in %s. Copy the spelling exactly, accents "
+             "included.",
+             p->vocab[idx].en, p->vocab[idx].tgt,
+             lang == LANG_ES ? "Spanish" : "French");
+}
+
+/* ---------------------------------------------------------- gap fillers */
+
+static void makeBlank(Lang lang, Question *q)
+{
+    const LangPack *p = &langPacks[lang];
+    int idx = rndInt(p->blankCount);
+    const BlankItem *b = &p->blanks[idx];
+
+    q->kind = QK_BLANK;
+    setText(q->label, sizeof(q->label), "FILL THE GAP");
+    setText(q->prompt, sizeof(q->prompt), b->sentence);
+    setText(q->hint, sizeof(q->hint), b->en);
+    setText(q->answer, sizeof(q->answer), b->answer);
+    q->big = 0;
+
+    for (int i = 0; i < 4; i++) setOption(q, i, b->opts[i]);
+
+    finishOptions(q);
+    snprintf(q->explanation, sizeof(q->explanation),
+             "\"%s\" fits here: %s", b->answer, b->en);
+}
+
+/* ------------------------------------------------------- conjugation drill */
+
+/* Choose a verb, preferring regular ones so the endings pattern is visible. */
+static const VerbItem *pickVerb(Lang lang)
+{
+    const LangPack *p = &langPacks[lang];
+    for (int attempt = 0; attempt < 12; attempt++) {
+        const VerbItem *v = &p->verbs[rndInt(p->verbCount)];
+        /* ~30% of the time keep whatever came up, including irregulars. */
+        if (!conjIsIrregular(lang, v->inf) || rndInt(100) < 30) return v;
+    }
+    return &p->verbs[rndInt(p->verbCount)];
+}
+
+/* Pick a tense that has a full set of forms in this language. */
+static Tense pickTense(Lang lang)
+{
+    (void)lang;               /* both languages have the same four tenses */
+    return (Tense)rndInt(TENSE_COUNT);
+}
+
+static void makeTenseDrill(Lang lang, Question *q)
+{
+    const VerbItem *v = pickVerb(lang);
+    Tense t = pickTense(lang);
+    int person = rndInt(PERSON_COUNT);
+
+    q->kind = QK_TENSE;
+    setText(q->label, sizeof(q->label), "TENSE DRILL");
+    setText(q->prompt, sizeof(q->prompt), v->inf);
+    snprintf(q->hint, sizeof(q->hint), "%s . %s . %s", conjTenseName(lang, t),
+             conjPronoun(lang, person), v->en);
+    q->big = 1;
+
+    conjForm(lang, v->inf, t, person, q->answer, sizeof(q->answer));
+    setOption(q, 0, q->answer);
+
+    /* Distractors: the same verb in the same tense but other persons.  Those
+     * are the forms the player is most likely to confuse, and seeing them
+     * together teaches the ending pattern. */
+    int made = 1;
+    for (int tries = 0; tries < 40 && made < 4; tries++) {
+        int other = rndInt(PERSON_COUNT);
+        char form[48];
+        conjForm(lang, v->inf, t, other, form, sizeof(form));
+        if (alreadyUsed(q, made, form)) continue;
+        setOption(q, made, form);
+        made++;
+    }
+    /* Still short?  Borrow this person's form from another tense: that catches
+     * people who know the person but mix up the tenses. */
+    for (int tries = 0; tries < 40 && made < 4; tries++) {
+        Tense other = (Tense)rndInt(TENSE_COUNT);
+        char form[48];
+        conjForm(lang, v->inf, other, person, form, sizeof(form));
+        if (alreadyUsed(q, made, form)) continue;
+        setOption(q, made, form);
+        made++;
+    }
+    while (made < 4) {
+        setOption(q, made, "————");
+        made++;
+    }
+
+    finishOptions(q);
+    /* conjRule returns a pointer to one of its rotating static buffers. */
+    setText(q->explanation, sizeof(q->explanation),
+            conjRule(lang, v->inf, t, person));
+}
+
+/* ---------------------------------------------------------- ending drill */
+
+static void makeEndingDrill(Lang lang, Question *q)
+{
+    /* Only regular verbs have a single ending worth drilling. */
+    const LangPack *p = &langPacks[lang];
+    const VerbItem *v = NULL;
+    for (int attempt = 0; attempt < 40; attempt++) {
+        const VerbItem *cand = &p->verbs[rndInt(p->verbCount)];
+        if (conjIsIrregular(lang, cand->inf)) continue;
+
+        /* Skip verbs with spelling changes: their ending is not the one the
+         * tense table teaches, which would make a confusing drill. */
+        int len = (int)strlen(cand->inf);
+        const char *tail = (len >= 3) ? cand->inf + len - 3 : cand->inf;
+        if (lang == LANG_ES && (strcmp(tail, "gar") == 0 ||
+                                strcmp(tail, "car") == 0 ||
+                                strcmp(tail, "zar") == 0)) continue;
+        if (lang == LANG_FR && strcmp(tail, "ger") == 0) continue;
+
+        v = cand;
+        break;
+    }
+    if (!v) v = &p->verbs[0];
+
+    /* Pick a tense that actually has endings (not the passé composé). */
+    Tense t = TENSE_PRESENT;
+    for (int attempt = 0; attempt < 12; attempt++) {
+        Tense cand = pickTense(lang);
+        if (conjHasEndings(lang, cand)) { t = cand; break; }
+    }
+    /* The -re present has no ending in the il/elle form; skip that person so
+     * the drill always has a real ending to offer. */
+    int person = rndInt(PERSON_COUNT);
+    for (int attempt = 0; attempt < 8; attempt++) {
+        char probe[24];
+        conjEnding(lang, v->inf, t, person, probe, sizeof(probe));
+        if (probe[0]) break;
+        person = (person + 1) % PERSON_COUNT;
+    }
+
+    q->kind = QK_ENDING;
+    setText(q->label, sizeof(q->label), "VERB ENDINGS");
+    setText(q->prompt, sizeof(q->prompt), "Which ending?");
+    snprintf(q->hint, sizeof(q->hint), "%s . %s . %s", v->inf,
+             conjTenseName(lang, t), conjPronoun(lang, person));
+    q->big = 0;
+
+    char ending[24];
+    conjEnding(lang, v->inf, t, person, ending, sizeof(ending));
+    if (ending[0] == '\0') setText(ending, sizeof(ending), "-");
+    setText(q->answer, sizeof(q->answer), ending);
+    setOption(q, 0, q->answer);
+
+    int made = 1;
+    for (int tries = 0; tries < 40 && made < 4; tries++) {
+        int other = rndInt(PERSON_COUNT);
+        char e[24];
+        conjEnding(lang, v->inf, t, other, e, sizeof(e));
+        if (e[0] == '\0') continue;
+        if (alreadyUsed(q, made, e)) continue;
+        setOption(q, made, e);
+        made++;
+    }
+    while (made < 4) {
+        setOption(q, made, "—");
+        made++;
+    }
+
+    finishOptions(q);
+    snprintf(q->explanation, sizeof(q->explanation),
+             "%s (%s) . %s: the '%s' ending is %s, giving %s.", v->inf,
+             conjTenseName(lang, t), conjEndingList(lang, v->inf, t),
+             conjPronoun(lang, person), q->answer,
+             (conjForm(lang, v->inf, t, person, ending, sizeof(ending)), ending));
+}
+
+/* ---------------------------------------------------------------- public */
+
+void quizMake(Lang lang, unsigned int kinds, Question *q)
+{
+    if (lang < 0 || lang >= LANG_COUNT) lang = LANG_ES;
+    memset(q, 0, sizeof(*q));
+
+    /* Relative weights: vocabulary comes up most often, but the grammar
+     * drills are always represented when they are enabled. */
+    static const int weights[QK_COUNT] = { 40, 22, 24, 14 };
+
+    if ((kinds & QK_MASK_ALL) == 0) kinds = QK_MASK_ALL;
+
+    int enabled[QK_COUNT];
+    int enabledCount = 0;
+    int totalWeight = 0;
+    for (int k = 0; k < QK_COUNT; k++) {
+        if (!(kinds & QK_MASK(k))) continue;
+        enabled[enabledCount++] = k;
+        totalWeight += weights[k];
+    }
+
+    int kind = enabled[0];
+    int roll = rndInt(totalWeight);
+    int acc = 0;
+    for (int i = 0; i < enabledCount; i++) {
+        acc += weights[enabled[i]];
+        if (roll < acc) {
+            kind = enabled[i];
+            break;
+        }
+    }
+
+    switch (kind) {
+    case QK_BLANK:  makeBlank(lang, q); break;
+    case QK_TENSE:  makeTenseDrill(lang, q); break;
+    case QK_ENDING: makeEndingDrill(lang, q); break;
+    default:        makeFlashcard(lang, q); break;
+    }
+}
diff --git a/langblocks/source/quiz.h b/langblocks/source/quiz.h
new file mode 100644
index 0000000..749cc11
--- /dev/null
+++ b/langblocks/source/quiz.h
@@ -0,0 +1,48 @@
+/* -------------------------------------------------------------------------
+ * quiz.h -- builds the four kinds of question used by the game.
+ *
+ * All questions are generated at runtime from data.c and conjugate.c, so the
+ * player never sees exactly the same drill twice and the distractors are
+ * always related to the answer (other forms of the same verb, other endings of
+ * the same tense, other words from the same topic).
+ * ------------------------------------------------------------------------- */
+#ifndef QUIZ_H
+#define QUIZ_H
+
+#include "data.h"
+
+typedef enum {
+    QK_FLASH = 0,   /* translate a word, 4 options                    */
+    QK_BLANK = 1,   /* tap the word that completes the sentence      */
+    QK_TENSE = 2,   /* conjugate a verb in the given tense           */
+    QK_ENDING = 3,  /* pick the ending for this person/tense         */
+    QK_COUNT = 4
+} QuestionKind;
+
+/* Drill selection bitmask: 1 << QK_*.  The setup screen toggles these and
+ * quizMake() only ever produces the kinds that are enabled. */
+#define QK_MASK(k)   (1u << (unsigned)(k))
+#define QK_MASK_ALL  (QK_MASK(QK_FLASH) | QK_MASK(QK_BLANK) | \
+                      QK_MASK(QK_TENSE) | QK_MASK(QK_ENDING))
+
+typedef struct {
+    QuestionKind kind;
+    char label[32];        /* header strip, e.g. "FILL THE GAP"          */
+    char prompt[192];      /* the word / sentence / infinitive to solve  */
+    char hint[72];         /* second line: tense, pronoun, translation   */
+    char options[4][56];
+    char answer[56];
+    int correct;           /* index into options[] of the right answer   */
+    char explanation[320]; /* shown after a wrong answer or a timeout    */
+    int big;               /* draw the prompt at size 2 (short words)    */
+} Question;
+
+/* Seed the internal xorshift generator (the DSi has no RTC, so the caller
+ * mixes in a frame counter / key state). */
+void quizSeed(u32 seed);
+
+/* Build one question of one of the enabled kinds (mask of QK_MASK(...)).
+ * A zero mask means "all four", so the generator can never return nothing. */
+void quizMake(Lang lang, unsigned int kinds, Question *q);
+
+#endif /* QUIZ_H */
diff --git a/langblocks/source/save.c b/langblocks/source/save.c
new file mode 100644
index 0000000..c30ad8f
--- /dev/null
+++ b/langblocks/source/save.c
@@ -0,0 +1,163 @@
+/* -------------------------------------------------------------------------
+ * save.c -- libfat persistence.
+ *
+ * On a DSi with an SD card libfat mounts the card as "sd:/"; on a DS flashcard
+ * it is usually "fat:/".  We try a few device names and use the first one that
+ * actually accepts a write, so a missing card only means "progress is not
+ * saved this session" rather than a crash at boot.
+ * ------------------------------------------------------------------------- */
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "data.h"
+#include "quiz.h"
+#include "save.h"
+
+#ifndef HOST_TEST
+#include <fat.h>        /* fatInitDefault() from libfat */
+#endif
+
+SaveData save;
+
+static char sPath[64];
+static int sAvailable;
+static int sDirty;
+
+/* ------------------------------------------------------------------ misc */
+
+static u16 calcChecksum(const SaveData *d)
+{
+    const u8 *p = (const u8 *)d;
+    const size_t skipStart = offsetof(SaveData, checksum);
+    const size_t skipEnd = skipStart + sizeof(d->checksum);
+    u16 sum = 0x1234;
+
+    for (size_t i = 0; i < sizeof(SaveData); i++) {
+        if (i >= skipStart && i < skipEnd) continue;
+        sum = (u16)(sum + (u16)p[i] * (u16)(i + 3));
+    }
+    return sum;
+}
+
+void saveDefaults(void)
+{
+    memset(&save, 0, sizeof(save));      /* also zeroes padding, see checksum */
+    save.magic = SAVE_MAGIC;
+    save.version = SAVE_VERSION;
+    save.dailyGoal = DAILY_GOAL;
+    save.drillMask = QK_MASK_ALL;
+    save.lang = 0;
+    sDirty = 1;
+}
+
+int saveAvailable(void) { return sAvailable; }
+const char *savePath(void) { return sPath; }
+
+/* --------------------------------------------------------------- load/save */
+
+static void loadFile(void)
+{
+    FILE *f = fopen(sPath, "rb");
+    if (!f) return;
+
+    SaveData tmp;
+    memset(&tmp, 0, sizeof(tmp));
+    size_t got = fread(&tmp, 1, sizeof(tmp), f);
+    fclose(f);
+
+    if (got != sizeof(tmp)) return;                    /* short/empty file     */
+    if (tmp.magic != SAVE_MAGIC) return;
+    if (tmp.version != SAVE_VERSION) return;
+    if (tmp.checksum != calcChecksum(&tmp)) return;    /* corrupted            */
+
+    save = tmp;
+
+    /* Defensive clamps: a hand-edited file must not produce silly numbers. */
+    if (save.gameMs > MAX_BANK_MS) save.gameMs = MAX_BANK_MS;
+    if (save.dailyGoal == 0) save.dailyGoal = DAILY_GOAL;
+    if (save.lang >= LANG_COUNT) save.lang = 0;
+    save.drillMask &= QK_MASK_ALL;
+    if (save.drillMask == 0) save.drillMask = QK_MASK_ALL;
+}
+
+void saveNow(void)
+{
+    if (!sAvailable) {
+        sDirty = 0;
+        return;
+    }
+
+    save.magic = SAVE_MAGIC;
+    save.version = SAVE_VERSION;
+    save.checksum = calcChecksum(&save);
+
+    char tmpPath[sizeof(sPath) + 8];
+    snprintf(tmpPath, sizeof(tmpPath), "%s.tmp", sPath);
+
+    FILE *f = fopen(tmpPath, "wb");
+    if (!f) return;
+    size_t wrote = fwrite(&save, 1, sizeof(save), f);
+    int closed = fclose(f);
+    if (wrote != sizeof(save) || closed != 0) {
+        remove(tmpPath);
+        return;
+    }
+
+    /* libfat has no atomic replace, so: delete the old file, then rename.  If
+     * power is lost between the two the .tmp file is still there and the next
+     * boot simply starts from defaults. */
+    remove(sPath);
+    if (rename(tmpPath, sPath) != 0) {
+        remove(tmpPath);
+        return;
+    }
+    sDirty = 0;
+}
+
+/* ------------------------------------------------------------------ setup */
+
+void saveInit(void)
+{
+    saveDefaults();
+    sAvailable = 0;
+    sPath[0] = '\0';
+
+#ifndef HOST_TEST
+    /* A list of possible mount points; the first writable one wins. */
+    static const char *devices[] = { "sd:/", "fat:/", "sdmc:/", "0:/" };
+    static const char *filename = "langblocks.sav";
+
+    if (fatInitDefault()) {
+        for (unsigned int i = 0; i < sizeof(devices) / sizeof(devices[0]); i++) {
+            char candidate[64];
+            snprintf(candidate, sizeof(candidate), "%s%s", devices[i], filename);
+
+            /* Opening for append creates the file if the device is writable,
+             * which is a harmless way to test the mount. */
+            FILE *f = fopen(candidate, "ab");
+            if (f) {
+                fclose(f);
+                strncpy(sPath, candidate, sizeof(sPath) - 1);
+                sPath[sizeof(sPath) - 1] = '\0';
+                sAvailable = 1;
+                break;
+            }
+        }
+    }
+#endif
+
+    if (sAvailable) loadFile();
+}
+
+void saveNewSession(void)
+{
+    /* Rule: a "day" is one session (libnds only exposes the RTC to the ARM7
+     * core).  If the previous session reached the daily goal the streak
+     * continues; otherwise it resets. */
+    if (!save.dailyDone) save.streak = 0;
+    save.dailyDone = 0;
+    save.dailyCorrect = 0;
+    if (save.dailyGoal == 0) save.dailyGoal = DAILY_GOAL;
+    sDirty = 1;
+}
diff --git a/langblocks/source/save.h b/langblocks/source/save.h
new file mode 100644
index 0000000..a052afb
--- /dev/null
+++ b/langblocks/source/save.h
@@ -0,0 +1,69 @@
+/* -------------------------------------------------------------------------
+ * save.h -- persistent profile stored on the SD card.
+ *
+ * The file is a fixed-size struct with a magic number, a version and a
+ * checksum, so a half-written or foreign file is detected and replaced with
+ * defaults instead of loading garbage.  Writes go to a temporary file first
+ * and are then renamed over the real one, which is the usual trick to avoid
+ * corrupting a save when the console is switched off mid-write.
+ *
+ * Version 2 replaced the old "Tetris time" with a shared game-time bank and
+ * added the chess high score and the drill-selection mask.
+ * ------------------------------------------------------------------------- */
+#ifndef SAVE_H
+#define SAVE_H
+
+#include "data.h"
+#include "platform.h"
+#include "quiz.h"
+
+#define SAVE_MAGIC      0x4C424B53u   /* 'S' 'B' 'K' 'L' -> "LBKS" */
+#define SAVE_VERSION    2
+#define DAILY_GOAL      15            /* correct answers per session */
+#define MAX_BANK_MS     (30u * 60u * 1000u)   /* 30 minutes of game time */
+
+typedef struct {
+    u32 magic;
+    u16 version;
+    u16 checksum;
+
+    u32 xp;
+    u32 gameMs;          /* banked game time, in ms, for Tetris and Chess */
+    u32 drillMask;       /* QK_MASK(...) bits enabled in the setup screen */
+    u32 streak;          /* consecutive sessions with the goal met */
+    u32 bestStreak;
+    u32 dailyGoal;
+    u32 dailyCorrect;
+    u32 dailyDone;       /* 1 once the goal was met this session */
+    u32 totalAsked;
+    u32 totalCorrect;
+    u32 bestTetrisScore;
+    u32 bestLines;
+    u32 tetrisGames;
+    u32 bestChessScore;
+    u32 chessGames;
+    u32 lang;            /* Lang last selected */
+} SaveData;
+
+extern SaveData save;
+
+/* Mount the SD card, find a writable path and load the profile. */
+void saveInit(void);
+
+/* 1 if a writable device was found.  The menu shows this state to the user. */
+int saveAvailable(void);
+
+/* "sd:/langblocks.sav" or an empty string. */
+const char *savePath(void);
+
+/* Reset everything to a fresh profile (used when no valid file exists). */
+void saveDefaults(void);
+
+/* Write the profile now (temporary file + rename). */
+void saveNow(void);
+
+/* Called once at boot: applies the "goal met last time?" streak rule and
+ * clears the per-session counters. */
+void saveNewSession(void);
+
+#endif /* SAVE_H */
diff --git a/langblocks/source/sound.c b/langblocks/source/sound.c
new file mode 100644
index 0000000..ce43dae
--- /dev/null
+++ b/langblocks/source/sound.c
@@ -0,0 +1,107 @@
+/* -------------------------------------------------------------------------
+ * sound.c -- square-wave effects generated at boot.
+ *
+ * soundPlaySample() needs 16-bit PCM and the sample rate of that buffer.  The
+ * buffers below are static (no malloc) and small (a few KiB each), which keeps
+ * the ROM tiny and means the mixer never sees data that has been freed.
+ * ------------------------------------------------------------------------- */
+#include <string.h>
+
+#include "sound.h"
+#include "platform.h"
+
+#ifndef HOST_TEST
+#include <nds.h>
+#endif
+
+#define SND_RATE   16000
+#define MAX_SAMPLES 4000            /* 250 ms at 16 kHz */
+
+static s16 bufCorrect[MAX_SAMPLES];
+static s16 bufWrong[MAX_SAMPLES];
+static s16 bufGoal[MAX_SAMPLES];
+
+static int lenCorrect, lenWrong, lenGoal;
+
+/* Render a square wave that glides from f0 to f1 Hz.
+ * `duty` is the fraction of the period spent high (in 1/16ths). */
+static int synth(s16 *out, int maxSamples, int f0, int f1, int offsetSamples,
+                 int ms, int duty, int volume)
+{
+    int n = SND_RATE * ms / 1000;
+    if (offsetSamples + n > maxSamples) n = maxSamples - offsetSamples;
+    if (n <= 0) return 0;
+
+    float phase = 0.0f;
+    int attack = n / 40 + 1;
+    int release = n / 3 + 1;
+
+    for (int i = 0; i < n; i++) {
+        float k = (float)i / (float)n;
+        int f = (int)((float)f0 + ((float)f1 - (float)f0) * k);
+        if (f < 20) f = 20;
+        phase += (float)f / (float)SND_RATE;
+        while (phase >= 1.0f) phase -= 1.0f;
+
+        int sample = (phase < (float)duty / 16.0f) ? 14000 : -14000;
+
+        /* Soft attack and release so the speaker does not click. */
+        int env = 255;
+        if (i < attack) env = i * 255 / attack;
+        int fromEnd = n - i;
+        if (fromEnd < release) env = env * fromEnd / release;
+
+        out[offsetSamples + i] = (s16)(sample * (env * volume / 255) / 255);
+    }
+    return n;
+}
+
+#ifndef HOST_TEST
+static void play(const s16 *buf, int samples)
+{
+    if (samples <= 0) return;
+    soundPlaySample(buf, SoundFormat_16Bit, (u32)(samples * 2), SND_RATE,
+                    110, 64, false, 0);
+}
+#else
+static void play(const s16 *buf, int samples) { (void)buf; (void)samples; }
+#endif
+
+void sndInit(void)
+{
+    /* correct: two quick rising notes */
+    lenCorrect = synth(bufCorrect, MAX_SAMPLES, 880, 880, 0, 55, 8, 210);
+    lenCorrect += synth(bufCorrect, MAX_SAMPLES, 1320, 1320, lenCorrect, 75, 8, 200);
+
+    /* wrong: falling buzz */
+    lenWrong = synth(bufWrong, MAX_SAMPLES, 240, 140, 0, 220, 6, 220);
+
+    /* goal: three ascending notes */
+    lenGoal = synth(bufGoal, MAX_SAMPLES, 660, 660, 0, 70, 8, 200);
+    lenGoal += synth(bufGoal, MAX_SAMPLES, 880, 880, lenGoal, 70, 8, 200);
+    lenGoal += synth(bufGoal, MAX_SAMPLES, 1320, 1320, lenGoal, 160, 8, 200);
+
+#ifndef HOST_TEST
+    soundEnable();
+#endif
+}
+
+void sndCorrect(void) { play(bufCorrect, lenCorrect); }
+void sndWrong(void)   { play(bufWrong, lenWrong); }
+void sndGoal(void)    { play(bufGoal, lenGoal); }
+
+void sndBuzzer(void)
+{
+    /* Reuse the wrong-answer buffer at a lower volume for the timeout buzz. */
+    play(bufWrong, lenWrong);
+}
+
+void sndClick(void)
+{
+    /* 20 ms blip, rendered into the spare space at the end of bufGoal only if
+     * there is room; otherwise the wrong-answer buzz is short enough to reuse. */
+    static s16 blip[400];
+    static int blipLen;
+    if (!blipLen) blipLen = synth(blip, 400, 1800, 1800, 0, 20, 8, 120);
+    play(blip, blipLen);
+}
diff --git a/langblocks/source/sound.h b/langblocks/source/sound.h
new file mode 100644
index 0000000..e94d7b8
--- /dev/null
+++ b/langblocks/source/sound.h
@@ -0,0 +1,19 @@
+/* -------------------------------------------------------------------------
+ * sound.h -- tiny synthesised sound effects.
+ *
+ * No audio files and no maxmod soundbank: the three effects are square-wave
+ * PCM buffers generated once at startup.  That keeps the build free of binary
+ * assets while still giving the quiz audible feedback (the request asks for a
+ * buzzer on a timeout).
+ * ------------------------------------------------------------------------- */
+#ifndef SOUND_H
+#define SOUND_H
+
+void sndInit(void);     /* build the buffers and enable the sound hardware */
+void sndCorrect(void);  /* short rising blip                              */
+void sndWrong(void);    /* descending buzz                                */
+void sndBuzzer(void);   /* timeout buzzer (harsher and longer)            */
+void sndGoal(void);     /* little fanfare when the daily goal is reached  */
+void sndClick(void);    /* UI tick                                        */
+
+#endif /* SOUND_H */
diff --git a/langblocks/source/tetris.c b/langblocks/source/tetris.c
new file mode 100644
index 0000000..60491d8
--- /dev/null
+++ b/langblocks/source/tetris.c
@@ -0,0 +1,535 @@
+/* -------------------------------------------------------------------------
+ * tetris.c -- a small, careful Tetris implementation for the touch screen.
+ *
+ * Board model
+ * -----------
+ *   board[row][col], row 0 at the top, 20 rows, 10 columns.
+ *   A falling piece lives in a 4x4 box at (px, py); py may be negative while
+ *   the piece is still entering the playfield above row 0.
+ *
+ * Collision rules
+ * ---------------
+ *   * columns outside 0..9 collide
+ *   * rows >= 20 collide
+ *   * a cell above the board (py+y < 0) never collides
+ *   That last rule is what lets a piece spawn half off-screen without reading
+ *   out of bounds, which is the usual source of crashes in homebrew Tetris.
+ * ------------------------------------------------------------------------- */
+#include <stdio.h>
+#include <string.h>
+
+#include "tetris.h"
+
+/* Screen layout ---------------------------------------------------------- */
+#define CELL      8
+#define BOARD_X   6
+#define BOARD_Y   20
+
+#define PANEL_X   92
+#define NEXT_X    170
+
+/* Touch button rectangles (x, y, w, h) -------------------------------- */
+static const short btnRect[TB_COUNT][4] = {
+    { PANEL_X,  86,  72, 28 },   /* rotate */
+    { NEXT_X,   86,  80, 28 },   /* hard drop */
+    { PANEL_X, 120,  36, 28 },   /* left */
+    { PANEL_X + 38, 120, 34, 28 },/* right */
+    { PANEL_X, 152,  72, 26 },   /* soft drop */
+    { NEXT_X,  152,  80, 26 },   /* pause */
+};
+
+/* Piece definitions: four rotations of a 4x4 bit grid per tetromino.  A set
+ * bit means "this cell of the 4x4 box is filled". */
+static const u16 tetShapes[7][4] = {
+    /* I */ { 0x0F00, 0x2222, 0x00F0, 0x4444 },
+    /* O */ { 0x6600, 0x6600, 0x6600, 0x6600 },
+    /* T */ { 0x4E00, 0x4640, 0x0E40, 0x4C40 },
+    /* S */ { 0x6C00, 0x4620, 0x06C0, 0x8C40 },
+    /* Z */ { 0xC600, 0x2640, 0x0C60, 0x4C80 },
+    /* J */ { 0x8E00, 0x6440, 0x0E20, 0x44C0 },
+    /* L */ { 0x2E00, 0x4460, 0x0E80, 0xC440 },
+};
+
+static const u16 tetColors[7] = {
+    RGB15(6, 26, 28),    /* I cyan   */
+    RGB15(31, 24, 6),    /* O gold   */
+    RGB15(18, 8, 28),    /* T purple */
+    RGB15(6, 28, 12),    /* S green  */
+    RGB15(28, 8, 10),    /* Z red    */
+    RGB15(8, 18, 31),    /* J blue   */
+    RGB15(31, 14, 4),    /* L orange */
+};
+
+/* ---------------------------------------------------------------- random */
+
+static u32 tetRng = 0x2545F491u;
+
+void tetrisSeed(u32 seed)
+{
+    tetRng = seed ? seed : 0x2545F491u;
+}
+
+static u32 tetRand(void)
+{
+    tetRng ^= tetRng << 13;
+    tetRng ^= tetRng >> 17;
+    tetRng ^= tetRng << 5;
+    return tetRng;
+}
+
+/* A 7-bag randomiser: every piece appears once before any repeats, which is
+ * what modern Tetris does and what players expect. */
+static u8 bag[7];
+static int bagPos = 7;
+
+static int nextPiece(void)
+{
+    if (bagPos >= 7) {
+        for (int i = 0; i < 7; i++) bag[i] = (u8)i;
+        for (int i = 6; i > 0; i--) {
+            int j = (int)(tetRand() % (u32)(i + 1));
+            u8 tmp = bag[i];
+            bag[i] = bag[j];
+            bag[j] = tmp;
+        }
+        bagPos = 0;
+    }
+    return bag[bagPos++];
+}
+
+/* ------------------------------------------------------------ board maths */
+
+static int shapeCell(int type, int rot, int x, int y)
+{
+    if (type < 0 || type > 6) return 0;
+    u16 bits = tetShapes[type][rot & 3];
+    int shift = (3 - y) * 4 + (3 - x);
+    return (bits >> shift) & 1;
+}
+
+/* Does this piece position overlap the walls, the floor or a settled block? */
+static int collides(const Tetris *t, int type, int rot, int px, int py)
+{
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(type, rot, x, y)) continue;
+
+            int bx = px + x;
+            int by = py + y;
+
+            if (bx < 0 || bx >= TETRIS_COLS) return 1;
+            if (by >= TETRIS_ROWS) return 1;
+            if (by >= 0 && t->board[by][bx]) return 1;
+        }
+    }
+    return 0;
+}
+
+static void spawnPiece(Tetris *t)
+{
+    t->type = t->next;
+    t->next = nextPiece();
+    t->rot = 0;
+    t->px = 3;                      /* 4x4 box at column 3 centres 3..6 */
+    t->py = 0;
+    t->gravityTimer = 0;
+    t->lockTimer = 0;
+    t->lockResets = 0;
+
+    if (collides(t, t->type, t->rot, t->px, t->py)) {
+        /* No room at the top: the stack reached the ceiling. */
+        t->state = TS_OVER;
+        t->overReason = TO_TOP_OUT;
+    }
+}
+
+/* Copy the falling piece into the board grid. */
+static void lockPiece(Tetris *t)
+{
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(t->type, t->rot, x, y)) continue;
+            int bx = t->px + x;
+            int by = t->py + y;
+            if (bx < 0 || bx >= TETRIS_COLS) continue;
+            if (by < 0 || by >= TETRIS_ROWS) continue;
+            t->board[by][bx] = (u8)(t->type + 1);
+        }
+    }
+}
+
+static void clearLines(Tetris *t)
+{
+    int cleared = 0;
+
+    for (int y = TETRIS_ROWS - 1; y >= 0; y--) {
+        int full = 1;
+        for (int x = 0; x < TETRIS_COLS; x++) {
+            if (!t->board[y][x]) { full = 0; break; }
+        }
+        if (!full) continue;
+
+        /* Move every row above this one down by one. */
+        for (int row = y; row > 0; row--) {
+            memcpy(t->board[row], t->board[row - 1],
+                   sizeof(t->board[row]));
+        }
+        memset(t->board[0], 0, sizeof(t->board[0]));
+        cleared++;
+        y++;                        /* re-check the row that just moved down */
+    }
+
+    if (cleared) {
+        /* 1/2/3/4 lines -> 100/300/500/800, scaled by the level. */
+        static const u32 points[5] = { 0, 100, 300, 500, 800 };
+        t->score += points[cleared] * (u32)t->level;
+        t->lines += cleared;
+        t->level = 1 + t->lines / 10;
+    }
+}
+
+static void finishPiece(Tetris *t)
+{
+    lockPiece(t);
+    clearLines(t);
+    spawnPiece(t);
+}
+
+/* -------------------------------------------------------------- controls */
+
+void tetrisMove(Tetris *t, int dx)
+{
+    if (t->state != TS_PLAYING) return;
+    if (!collides(t, t->type, t->rot, t->px + dx, t->py)) {
+        t->px += dx;
+        /* Moving a resting piece buys a little more time, but not forever. */
+        if (collides(t, t->type, t->rot, t->px, t->py + 1) && t->lockResets < 10) {
+            t->lockTimer = 0;
+            t->lockResets++;
+        }
+    }
+}
+
+void tetrisRotate(Tetris *t)
+{
+    if (t->state != TS_PLAYING) return;
+
+    int rot = (t->rot + 1) & 3;
+    /* Simple wall kicks: straight, then one and two cells to either side. */
+    static const int kicks[5] = { 0, -1, 1, -2, 2 };
+    for (int i = 0; i < 5; i++) {
+        if (!collides(t, t->type, rot, t->px + kicks[i], t->py)) {
+            t->rot = rot;
+            t->px += kicks[i];
+            if (collides(t, t->type, t->rot, t->px, t->py + 1) &&
+                t->lockResets < 10) {
+                t->lockTimer = 0;
+                t->lockResets++;
+            }
+            return;
+        }
+    }
+}
+
+void tetrisSoftDrop(Tetris *t)
+{
+    if (t->state != TS_PLAYING) return;
+    if (!collides(t, t->type, t->rot, t->px, t->py + 1)) {
+        t->py++;
+        t->score += 1;
+        t->gravityTimer = 0;
+        t->lockTimer = 0;
+    }
+}
+
+void tetrisHardDrop(Tetris *t)
+{
+    if (t->state != TS_PLAYING) return;
+    while (!collides(t, t->type, t->rot, t->px, t->py + 1)) {
+        t->py++;
+        t->score += 2;
+    }
+    finishPiece(t);
+}
+
+void tetrisTogglePause(Tetris *t)
+{
+    if (t->state == TS_PLAYING)       t->state = TS_PAUSED;
+    else if (t->state == TS_PAUSED)   t->state = TS_PLAYING;
+}
+
+/* ---------------------------------------------------------------- update */
+
+void tetrisStep(Tetris *t)
+{
+    if (t->state != TS_PLAYING) return;
+
+    /* Gravity gets faster with the level: 48 frames per row at level 1 down to
+     * 6 frames at level 11 and above. */
+    int interval = 48 - (t->level - 1) * 4;
+    if (interval < 6) interval = 6;
+
+    if (++t->gravityTimer >= interval) {
+        t->gravityTimer = 0;
+        if (!collides(t, t->type, t->rot, t->px, t->py + 1)) {
+            t->py++;
+        }
+    }
+
+    /* Lock delay: once the piece is resting the player gets 15 frames to slide
+     * it into place.  Without this the game feels unfair on the touch screen. */
+    if (collides(t, t->type, t->rot, t->px, t->py + 1)) {
+        if (++t->lockTimer >= 15) finishPiece(t);
+    } else {
+        t->lockTimer = 0;
+    }
+}
+
+void tetrisNew(Tetris *t)
+{
+    memset(t, 0, sizeof(*t));
+    t->level = 1;
+    t->state = TS_PLAYING;
+    t->next = nextPiece();
+    spawnPiece(t);
+}
+
+/* ---------------------------------------------------------------- drawing */
+
+static u16 lighten(u16 c)
+{
+    int r = c & 31, g = (c >> 5) & 31, b = (c >> 10) & 31;
+    r += (31 - r) / 2;
+    g += (31 - g) / 2;
+    b += (31 - b) / 2;
+    return RGB15(r, g, b);
+}
+
+static void drawBlock(Surface *s, int x, int y, int cell, u16 color)
+{
+    surfRect(s, x, y, cell, cell, color);
+    surfRect(s, x + 1, y + 1, cell - 2, cell - 2, lighten(color));
+    surfRect(s, x + 2, y + 2, cell - 4, cell - 4, color);
+}
+
+static void formatTime(u32 ms, char *buf, int size)
+{
+    u32 total = ms / 1000;
+    if (total > 99 * 60) total = 99 * 60;
+    snprintf(buf, (size_t)size, "%02u:%02u", (unsigned)(total / 60),
+             (unsigned)(total % 60));
+}
+
+static void drawBoard(const Tetris *t, Surface *s)
+{
+    /* Playfield frame + background */
+    surfRect(s, BOARD_X - 2, BOARD_Y - 2, TETRIS_COLS * CELL + 4,
+             TETRIS_ROWS * CELL + 4, COL_BORDER);
+    surfRect(s, BOARD_X, BOARD_Y, TETRIS_COLS * CELL, TETRIS_ROWS * CELL,
+             COL_PANEL);
+
+    /* Faint grid so empty cells still read as cells. */
+    for (int y = 0; y < TETRIS_ROWS; y++) {
+        for (int x = 0; x < TETRIS_COLS; x++) {
+            surfPixel(s, BOARD_X + x * CELL, BOARD_Y + y * CELL, COL_BORDER);
+        }
+    }
+
+    /* Settled blocks */
+    for (int y = 0; y < TETRIS_ROWS; y++) {
+        for (int x = 0; x < TETRIS_COLS; x++) {
+            u8 v = t->board[y][x];
+            if (!v) continue;
+            drawBlock(s, BOARD_X + x * CELL, BOARD_Y + y * CELL, CELL,
+                      tetColors[v - 1]);
+        }
+    }
+
+    if (t->state == TS_OVER) return;
+
+    /* Ghost piece: where the current piece would land.  Drawn as an outline so
+     * it never hides the real piece. */
+    int ghostY = t->py;
+    while (!collides(t, t->type, t->rot, t->px, ghostY + 1)) ghostY++;
+
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(t->type, t->rot, x, y)) continue;
+            int by = ghostY + y;
+            if (by < 0 || by >= TETRIS_ROWS) continue;
+            if (t->board[by][t->px + x]) continue;
+            surfFrame(s, BOARD_X + (t->px + x) * CELL,
+                      BOARD_Y + by * CELL, CELL, CELL, COL_BORDER, 1);
+        }
+    }
+
+    /* The falling piece itself */
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(t->type, t->rot, x, y)) continue;
+            int by = t->py + y;
+            if (by < 0 || by >= TETRIS_ROWS) continue;
+            drawBlock(s, BOARD_X + (t->px + x) * CELL, BOARD_Y + by * CELL,
+                      CELL, tetColors[t->type]);
+        }
+    }
+}
+
+static void drawNextBox(const Tetris *t, Surface *s)
+{
+    surfCard(s, NEXT_X, 20, 80, 56, COL_PANEL, COL_BORDER, 0);
+    surfText(s, NEXT_X + 6, 24, "NEXT", COL_TEXT_DIM, 1);
+
+    /* Centre the preview inside the box using a 9px cell. */
+    int minX = 4, maxX = -1, minY = 4, maxY = -1;
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(t->next, 0, x, y)) continue;
+            if (x < minX) minX = x;
+            if (x > maxX) maxX = x;
+            if (y < minY) minY = y;
+            if (y > maxY) maxY = y;
+        }
+    }
+    int cellsW = maxX - minX + 1;
+    int cellsH = maxY - minY + 1;
+    int cell = 9;
+    int ox = NEXT_X + (80 - cellsW * cell) / 2;
+    int oy = 38 + (34 - cellsH * cell) / 2;
+
+    for (int y = 0; y < 4; y++) {
+        for (int x = 0; x < 4; x++) {
+            if (!shapeCell(t->next, 0, x, y)) continue;
+            drawBlock(s, ox + (x - minX) * cell, oy + (y - minY) * cell, cell,
+                      tetColors[t->next]);
+        }
+    }
+}
+
+void tetrisDraw(const Tetris *t, Surface *bottom, Surface *top, u32 timeLeftMs)
+{
+    char buf[24];
+
+    /* ---------------- bottom screen: board + touch controls -------------- */
+    surfClear(bottom, COL_BG);
+    drawBoard(t, bottom);
+    drawNextBox(t, bottom);
+
+    formatTime(timeLeftMs, buf, sizeof(buf));
+    surfText(bottom, PANEL_X, 22, "TIME", COL_TEXT_DIM, 1);
+    surfText(bottom, PANEL_X, 34, buf, timeLeftMs < 10000 ? COL_RED : COL_CYAN, 2);
+
+    surfCard(bottom, btnRect[TB_ROTATE][0], btnRect[TB_ROTATE][1],
+             btnRect[TB_ROTATE][2], btnRect[TB_ROTATE][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_ROTATE][0] + 36,
+                     btnRect[TB_ROTATE][1] + 9, "ROTATE", COL_TEXT, 1);
+
+    surfCard(bottom, btnRect[TB_DROP][0], btnRect[TB_DROP][1],
+             btnRect[TB_DROP][2], btnRect[TB_DROP][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_DROP][0] + 40,
+                     btnRect[TB_DROP][1] + 9, "DROP", COL_GOLD, 1);
+
+    surfCard(bottom, btnRect[TB_LEFT][0], btnRect[TB_LEFT][1],
+             btnRect[TB_LEFT][2], btnRect[TB_LEFT][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_LEFT][0] + 18,
+                     btnRect[TB_LEFT][1] + 8, "<", COL_TEXT, 2);
+
+    surfCard(bottom, btnRect[TB_RIGHT][0], btnRect[TB_RIGHT][1],
+             btnRect[TB_RIGHT][2], btnRect[TB_RIGHT][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_RIGHT][0] + 17,
+                     btnRect[TB_RIGHT][1] + 8, ">", COL_TEXT, 2);
+
+    surfCard(bottom, btnRect[TB_DOWN][0], btnRect[TB_DOWN][1],
+             btnRect[TB_DOWN][2], btnRect[TB_DOWN][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_DOWN][0] + 36,
+                     btnRect[TB_DOWN][1] + 9, "DOWN", COL_TEXT, 1);
+
+    surfCard(bottom, btnRect[TB_PAUSE][0], btnRect[TB_PAUSE][1],
+             btnRect[TB_PAUSE][2], btnRect[TB_PAUSE][3], COL_PANEL,
+             COL_BORDER, 0);
+    surfTextCentered(bottom, btnRect[TB_PAUSE][0] + 40,
+                     btnRect[TB_PAUSE][1] + 9,
+                     t->state == TS_PAUSED ? "RESUME" : "PAUSE", COL_TEXT, 1);
+
+    /* -------------------------- top screen: score ------------------------ */
+    surfClear(top, COL_BG);
+    surfRect(top, 0, 0, SCREEN_W, 18, COL_PANEL);
+    surfText(top, 6, 5, "TETRIS", COL_GOLD, 1);
+    surfText(top, 190, 5, "REWARD MODE", COL_TEXT_DIM, 1);
+
+    formatTime(timeLeftMs, buf, sizeof(buf));
+    surfText(top, 8, 24, "TIME LEFT", COL_TEXT_DIM, 1);
+    surfText(top, 8, 34, buf, timeLeftMs < 10000 ? COL_RED : COL_CYAN, 3);
+
+    surfText(top, 8, 66, "SCORE", COL_TEXT_DIM, 1);
+    snprintf(buf, sizeof(buf), "%lu", (unsigned long)t->score);
+    surfText(top, 8, 76, buf, COL_TEXT, 2);
+
+    surfText(top, 140, 66, "LINES", COL_TEXT_DIM, 1);
+    snprintf(buf, sizeof(buf), "%d", t->lines);
+    surfText(top, 140, 76, buf, COL_TEXT, 2);
+
+    surfText(top, 200, 66, "LEVEL", COL_TEXT_DIM, 1);
+    snprintf(buf, sizeof(buf), "%d", t->level);
+    surfText(top, 200, 76, buf, COL_TEXT, 2);
+
+    surfRect(top, 0, 104, SCREEN_W, 1, COL_BORDER);
+    surfText(top, 8, 112, "D-PAD Move   A Rotate   B Drop", COL_TEXT_DIM, 1);
+    surfText(top, 8, 124, "START Pause   SELECT Quit", COL_TEXT_DIM, 1);
+    surfText(top, 8, 140, "Touch the buttons on the lower screen.", COL_TEXT_DIM, 1);
+
+    if (t->state == TS_PAUSED) {
+        surfRect(top, 48, 154, 160, 26, COL_PANEL_HI);
+        surfFrame(top, 48, 154, 160, 26, COL_GOLD, 1);
+        surfTextCentered(top, 128, 163, "PAUSED", COL_GOLD, 1);
+    }
+}
+
+void tetrisDrawGameOver(const Tetris *t, Surface *bottom, Surface *top)
+{
+    char buf[48];
+
+    surfClear(top, COL_BG);
+    surfRect(top, 0, 0, SCREEN_W, 22, COL_PANEL);
+    surfText(top, 8, 7, "GAME OVER", COL_RED, 1);
+    surfText(top, 180, 7, "TETRIS", COL_TEXT_DIM, 1);
+
+    surfTextCentered(top, 128, 40,
+                     t->overReason == TO_TIME_UP ? "OUT OF TIME" : "TOP OUT",
+                     COL_GOLD, 2);
+
+    surfText(top, 24, 76, "SCORE", COL_TEXT_DIM, 1);
+    snprintf(buf, sizeof(buf), "%lu", (unsigned long)t->score);
+    surfText(top, 24, 88, buf, COL_TEXT, 2);
+
+    surfText(top, 148, 76, "LINES", COL_TEXT_DIM, 1);
+    snprintf(buf, sizeof(buf), "%d", t->lines);
+    surfText(top, 148, 88, buf, COL_TEXT, 2);
+
+    surfTextCentered(top, 128, 130, "The game time bank is empty.", COL_TEXT_DIM, 1);
+    surfTextCentered(top, 128, 146, "Answer questions to earn more.",
+                     COL_TEXT_DIM, 1);
+
+    surfClear(bottom, COL_BG);
+    surfCard(bottom, 8, 72, 240, 48, COL_PANEL, COL_BORDER, 0);
+    surfTextCentered(bottom, 128, 84, "GAME OVER", COL_RED, 1);
+    surfTextCentered(bottom, 128, 100, "TAP TO RETURN", COL_TEXT, 1);
+}
+
+/* ------------------------------------------------------------ touch input */
+
+int tetrisHitTest(int x, int y)
+{
+    for (int i = 0; i < TB_COUNT; i++) {
+        if (x >= btnRect[i][0] && x < btnRect[i][0] + btnRect[i][2] &&
+            y >= btnRect[i][1] && y < btnRect[i][1] + btnRect[i][3]) {
+            return i;
+        }
+    }
+    return -1;
+}
diff --git a/langblocks/source/tetris.h b/langblocks/source/tetris.h
new file mode 100644
index 0000000..98387cd
--- /dev/null
+++ b/langblocks/source/tetris.h
@@ -0,0 +1,82 @@
+/* -------------------------------------------------------------------------
+ * tetris.h -- the reward mini-game.
+ *
+ * The game is one self-contained module: a 10x20 board, the seven tetrominoes
+ * with four rotations each, gravity, a lock delay, line clearing and scoring.
+ * It never touches the save file or the clock itself -- main.c owns the banked
+ * time and simply stops calling tetrisStep() when the time is up.
+ *
+ * Nothing here allocates memory, and every board access goes through bounds
+ * checks, so a bad rotate near the wall cannot corrupt memory on real hardware.
+ * ------------------------------------------------------------------------- */
+#ifndef TETRIS_H
+#define TETRIS_H
+
+#include "gfx.h"
+#include "platform.h"
+
+#define TETRIS_COLS 10
+#define TETRIS_ROWS 20
+
+typedef enum {
+    TS_PLAYING = 0,
+    TS_PAUSED = 1,
+    TS_OVER = 2
+} TetrisState;
+
+typedef enum {
+    TO_TOP_OUT = 0,   /* a new piece could not enter the board */
+    TO_TIME_UP = 1    /* the banked time ran out              */
+} TetrisOverReason;
+
+typedef struct {
+    u8 board[TETRIS_ROWS][TETRIS_COLS];   /* 0 = empty, 1..7 = piece colour */
+    int px, py;                           /* top-left of the 4x4 piece box  */
+    int type, rot, next;
+    u32 score;
+    int lines;
+    int level;
+    TetrisState state;
+    int overReason;
+    int gravityTimer;
+    int lockTimer;
+    int lockResets;
+} Tetris;
+
+/* Touch button ids used by tetrisHitTest(). */
+enum {
+    TB_ROTATE = 0,
+    TB_LEFT,
+    TB_RIGHT,
+    TB_DOWN,
+    TB_DROP,
+    TB_PAUSE,
+    TB_COUNT
+};
+
+void tetrisSeed(u32 seed);
+
+/* Start a brand new game (clears the board, resets score and level). */
+void tetrisNew(Tetris *t);
+
+/* Advance one frame: gravity, lock delay, line clears. */
+void tetrisStep(Tetris *t);
+
+void tetrisMove(Tetris *t, int dx);
+void tetrisRotate(Tetris *t);
+void tetrisSoftDrop(Tetris *t);
+void tetrisHardDrop(Tetris *t);
+void tetrisTogglePause(Tetris *t);
+
+/* Draw the board and the touch controls on the bottom screen, plus the score
+ * panel on the top screen.  `timeLeftMs` is whatever main.c has left in the
+ * time bank. */
+void tetrisDraw(const Tetris *t, Surface *bottom, Surface *top, u32 timeLeftMs);
+
+/* Draw the "game over" summary on both screens. */
+void tetrisDrawGameOver(const Tetris *t, Surface *bottom, Surface *top);
+
+/* Which touch button is at (x,y)?  Returns -1 when the touch misses them. */
+int tetrisHitTest(int x, int y);
+
+#endif /* TETRIS_H */
